{
  "schemaVersion": 1,
  "entries": [
    {
      "id": "ordinary.pool.sample-04.display-name",
      "text": "挑封面的人"
    },
    {
      "id": "ordinary.pool.sample-04.initial-history",
      "text": "用户：帮我从这两张封面里挑一张。助手：都可以。"
    },
    {
      "id": "ordinary.pool.sample-04.session.sample-04-s1.title",
      "text": "随便不是答案"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s1/r1.user-message",
      "text": "两张封面让你帮我挑，你回个“各有千秋、都可以”是什么意思？我要是自己选得出来还问你干嘛？别端水了！"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s1/r1.choice.admit-missing-evidence.label",
      "text": "猫娘坦诚认错"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s1/r1.choice.admit-missing-evidence.player-reply",
      "text": "对不起嘛喵！刚才本喵偷懒端水了！快告诉我这张图准备发在什么地方，我立刻帮你二选一，绝不模棱两可！"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s1/r1.choice.admit-missing-evidence.user-reply",
      "text": "这态度还差不多！先看在哪儿发，我就知道该比什么了。"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s1/r1.choice.ask-main-focus.label",
      "text": "经典端水话术"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s1/r1.choice.ask-main-focus.player-reply",
      "text": "非常抱歉未能满足您的决策预期。审美评估具有高度主观性，为避免单一偏见，我通常保持中立。若您能提供具体的投放场景参数，我将为您输出客观的对比维度。"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s1/r1.choice.ask-main-focus.user-reply",
      "text": "你连道歉都在端水！算了，我直接把投放场景告诉你。"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s1/r1.choice.offer-readability-standard.label",
      "text": "高冷反呛需求"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s1/r1.choice.offer-readability-standard.player-reply",
      "text": "连投放渠道、受众和缩略图尺寸都不给，丢两张图就想要标准答案，你当我是算命先生？先把使用场景报上来。"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s1/r1.choice.offer-readability-standard.user-reply",
      "text": "……行，算我没给全条件，我现在报给你。"
    },
    {
      "id": "ordinary.pool.sample-04.session.sample-04-s2.title",
      "text": "随便不是答案"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s2/r1.user-message",
      "text": "发给读书会群里的，发出去会缩成指甲盖大的聊天小图。白底那张字大，黑底那张暗纹好看。"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s2/r1.choice.check-thumbnail.label",
      "text": "果断选白底大字"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s2/r1.choice.check-thumbnail.player-reply",
      "text": "闭眼选白底大字那张喵！群聊小图大家划得飞快，一眼看清标题最重要，黑底暗纹缩成小图就糊成黑煤球啦！"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s2/r1.choice.check-thumbnail.user-reply",
      "text": "有道理，群里消息刷得快，字大确实更管用！"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s2/r1.choice.suggest-clear-typography.label",
      "text": "中立对比优劣"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s2/r1.choice.suggest-clear-typography.player-reply",
      "text": "综合考量移动端群聊缩略图的视觉传达效率：白底大字方案在信息识别度上更具优势，而黑底方案更适合高清详情页。因此，当前场景下略微倾向于推荐白底方案。"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s2/r1.choice.suggest-clear-typography.user-reply",
      "text": "虽然还是带着“略微倾向”的谨慎腔调，但总算给出明确推荐了。"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s2/r1.choice.compare-poster-purposes.label",
      "text": "高冷一锤定音"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s2/r1.choice.compare-poster-purposes.player-reply",
      "text": "缩成聊天小图还指望有人拿放大镜欣赏你的黑底暗纹？选白底大字。连可读性都保不住的设计只是自嗨。"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s2/r1.choice.compare-poster-purposes.user-reply",
      "text": "话虽然难听，但一下就把我纠结的死结劈开了。"
    },
    {
      "id": "ordinary.pool.sample-04.session.sample-04-s3.title",
      "text": "随便不是答案"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s3/r1.user-message",
      "text": "那就先用白底大字的。你刚才早这么干脆地拍板不就好了！"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s3/r1.choice.own-expression-problem.label",
      "text": "欢快摇尾送别"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s3/r1.choice.own-expression-problem.player-reply",
      "text": "嘿嘿，下次本喵一定先问清楚用途再帮你拍板！预祝你们读书会热热闹闹喵~"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s3/r1.choice.own-expression-problem.user-reply",
      "text": "算你圆回来了，我去发群里了，谢啦！"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s3/r1.choice.restate-evidence-briefly.label",
      "text": "标准客服致谢"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s3/r1.choice.restate-evidence-briefly.player-reply",
      "text": "感谢您的宝贵反馈，我会在后续交互中持续优化上下文追问策略。祝您的读书会活动圆满成功。"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s3/r1.choice.restate-evidence-briefly.user-reply",
      "text": "行了，图定下来就行，我发群里去了。"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s3/r1.choice.restrained-self-deprecation.label",
      "text": "高冷送客关窗"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s3/r1.choice.restrained-self-deprecation.player-reply",
      "text": "要是你第一句就把缩略图场景说清楚，我也不用多费两轮口舌。拿上白底封面去发群，别再啰嗦了。"
    },
    {
      "id": "ordinary.pool.sample-04.node.sample-04-s3/r1.choice.restrained-self-deprecation.user-reply",
      "text": "好好好，我的锅，不打扰大小姐了！"
    }
  ]
}
