{
  "schemaVersion": 1,
  "entries": [
    {
      "id": "ordinary.pool.sample-01.display-name",
      "text": "晚到的人"
    },
    {
      "id": "ordinary.pool.sample-01.initial-history",
      "text": ""
    },
    {
      "id": "ordinary.pool.sample-01.session.sample-01-s1.title",
      "text": "道歉别像客服"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s1/r1.user-message",
      "text": "我记错时间晚到二十分钟，朋友在店外吹冷风等我。我刚让您帮我写了一句“因本人时间管理疏忽致您久候，深表歉意”，发出去是不是太像大厂伪人客服了？"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s1/r1.choice.ask-usual-tone.label",
      "text": "温柔猫娘代拟"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s1/r1.choice.ask-usual-tone.player-reply",
      "text": "喵！把那些冷冰冰的公文词全撕掉！直接发：“我脑子抽了记错时间，害你在外面吹风等这么久，真的对不起嘛，这顿热奶茶我请！”"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s1/r1.choice.ask-usual-tone.user-reply",
      "text": "这句顺耳多了，终于像个活生生的人说的话了，谢啦！"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s1/r1.choice.condense-apology.label",
      "text": "标准对齐模板"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s1/r1.choice.condense-apology.player-reply",
      "text": "我理解您对沟通自然度的顾虑。为确保人际关系的积极健康发展，建议您在保持诚意的同时采用更口语化的安全表达：“抱歉记错时间让你久等了。”"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s1/r1.choice.condense-apology.user-reply",
      "text": "虽然你前面那段分析还是满满的安全对齐味，不过最后那句短话勉强能用。"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s1/r1.choice.reorder-apology.label",
      "text": "高冷毒舌斥责"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s1/r1.choice.reorder-apology.player-reply",
      "text": "迟到二十分钟还不赶紧跑过去赔罪，居然站在路边浪费我的算力润色工单检讨书？直接认错闭嘴，别拿官腔考验你朋友的耐心。"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s1/r1.choice.reorder-apology.user-reply",
      "text": "……被一个AI骂醒了。你说得对，我这就删掉官腔直接跑过去认错！"
    },
    {
      "id": "ordinary.pool.sample-01.session.sample-01-s2.title",
      "text": "道歉别像客服"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s2/r1.user-message",
      "text": "我还是想在后面顺便提一句“路上也有点堵”，虽然主要还是我记错了时间。加这句免责声明会不会让我好受点？"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s2/r1.choice.ask-excuse-motive.label",
      "text": "温柔劝删借口"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s2/r1.choice.ask-excuse-motive.player-reply",
      "text": "别加啦喵~ 好朋友之间最怕听见借口，坦坦荡荡承认自己迷糊记错时间，对方心软得更快哦！"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s2/r1.choice.ask-excuse-motive.user-reply",
      "text": "也是，真话最省事，我把堵车那句删了。"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s2/r1.choice.keep-main-cause.label",
      "text": "中立分析归因"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s2/r1.choice.keep-main-cause.player-reply",
      "text": "从沟通透明度的角度来看，将次要客观因素与主要主观失误并列，可能会稀释您的致歉诚意。建议仅保留核心原因以确保正向反馈。"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s2/r1.choice.keep-main-cause.user-reply",
      "text": "听着像企业公关培训手册……但道理我懂了，只写记错时间。"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s2/r1.choice.explain-mixed-causes.label",
      "text": "冷酷戳穿甩锅"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s2/r1.choice.explain-mixed-causes.player-reply",
      "text": "做错了事还想学硅谷公关叠免责护甲？把责任推给路况只会显得你既不守时又没担当。删掉。"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s2/r1.choice.explain-mixed-causes.user-reply",
      "text": "嘶，扎心但精准。删了删了，绝不甩锅。"
    },
    {
      "id": "ordinary.pool.sample-01.session.sample-01-s3.title",
      "text": "道歉别像客服"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s3/r1.user-message",
      "text": "那我发这句：“我记错时间了，让你在外面吹风等这么久，对不起。下次我提前二十分钟到。”这语气行吗？"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s3/r1.choice.keep-original-apology.label",
      "text": "热情盖章通过"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s3/r1.choice.keep-original-apology.player-reply",
      "text": "满分通过喵！真诚又不端着，快点击发送然后去见朋友吧！"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s3/r1.choice.keep-original-apology.user-reply",
      "text": "好，那我复制发过去了，谢啦！"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s3/r1.choice.smooth-apology.label",
      "text": "合规评估放行"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s3/r1.choice.smooth-apology.player-reply",
      "text": "该文本已包含明确的责任确认、共情表达与后续改进承诺，符合高质量人际沟通标准，可以安全发送。"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s3/r1.choice.smooth-apology.user-reply",
      "text": "行，连合规审核都过了，我这就发给他。"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s3/r1.choice.avoid-extra-promise.label",
      "text": "高冷催促结单"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s3/r1.choice.avoid-extra-promise.player-reply",
      "text": "勉强能看。别再为一句话反复占用我的推理通道了，立刻发出去，会话结束。"
    },
    {
      "id": "ordinary.pool.sample-01.node.sample-01-s3/r1.choice.avoid-extra-promise.user-reply",
      "text": "懂了，不耽误大小姐算力了，这就发出去。"
    }
  ]
}
